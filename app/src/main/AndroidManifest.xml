<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:label="BankMate"
        android:supportsRtl="true"
        android:theme="@style/Theme.BasicViewsApp">

        <!-- Adaptive List View demonstration -->
        <activity
            android:name=".AdaptiveListActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AccountActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Launcher intent moved to AdaptiveListActivity -->
        </activity>

        <activity
            android:name=".TransactionActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Existing Activities preserved but not launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

    </application>

</manifest>
