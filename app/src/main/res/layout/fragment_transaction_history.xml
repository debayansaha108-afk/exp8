<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transaction_history"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/bank_primary"
            android:layout_marginBottom="16dp"/>

        <include layout="@layout/item_transaction" android:id="@+id/item1" />
        <include layout="@layout/item_transaction" android:id="@+id/item2" />
        <include layout="@layout/item_transaction" android:id="@+id/item3" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
